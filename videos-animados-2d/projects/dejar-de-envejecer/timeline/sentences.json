[
 {
  "i": 0,
  "start": 0.0,
  "end": 2.08,
  "text": "El portero del bar mira tu identificación."
 },
 {
  "i": 1,
  "start": 2.6,
  "end": 3.62,
  "text": "Luego te mira a ti."
 },
 {
  "i": 2,
  "start": 4.16,
  "end": 5.94,
  "text": "Luego otra vez la identificación."
 },
 {
  "i": 3,
  "start": 6.68,
  "end": 9.12,
  "text": "Aquí dice que naciste en 1981."
 },
 {
  "i": 4,
  "start": 9.96,
  "end": 10.18,
  "text": "Sí."
 },
 {
  "i": 5,
  "start": 10.74,
  "end": 12.08,
  "text": "¿Tienes cuarenta y cinco años?"
 },
 {
  "i": 6,
  "start": 12.66,
  "end": 12.92,
  "text": "Sí."
 },
 {
  "i": 7,
  "start": 13.5,
  "end": 14.0,
  "text": "Amigo..."
 },
 {
  "i": 8,
  "start": 14.48,
  "end": 15.44,
  "text": "¿qué crema usas?"
 },
 {
  "i": 9,
  "start": 16.06,
  "end": 16.96,
  "text": "Te llamas Sam."
 },
 {
  "i": 10,
  "start": 17.38,
  "end": 18.84,
  "text": "Y hace veinticinco años..."
 },
 {
  "i": 11,
  "start": 18.84,
  "end": 20.38,
  "text": "dejaste de envejecer."
 },
 {
  "i": 12,
  "start": 20.88,
  "end": 23.32,
  "text": "Tu mejor amigo Leo ya tiene canas."
 },
 {
  "i": 13,
  "start": 23.32,
  "end": 25.84,
  "text": "Tú tienes la misma cara de tu foto de graduación."
 },
 {
  "i": 14,
  "start": 26.32,
  "end": 27.6,
  "text": "Tu rodilla no cruje."
 },
 {
  "i": 15,
  "start": 27.6,
  "end": 28.68,
  "text": "Y en tu billetera..."
 },
 {
  "i": 16,
  "start": 28.68,
  "end": 30.38,
  "text": "sigue el carnet de estudiante."
 },
 {
  "i": 17,
  "start": 30.7,
  "end": 31.38,
  "text": "Por si acaso."
 },
 {
  "i": 18,
  "start": 31.9,
  "end": 36.06,
  "text": "Una persona normal empieza a perder masa muscular después de los treinta."
 },
 {
  "i": 19,
  "start": 36.06,
  "end": 38.66,
  "text": "Entre tres y ocho por ciento cada década."
 },
 {
  "i": 20,
  "start": 39.12,
  "end": 39.34,
  "text": "¿Tú?"
 },
 {
  "i": 21,
  "start": 39.34,
  "end": 41.46,
  "text": "Te detuviste a los veinte."
 },
 {
  "i": 22,
  "start": 41.46,
  "end": 42.26,
  "text": "Para siempre."
 },
 {
  "i": 23,
  "start": 42.82,
  "end": 44.0,
  "text": "Pero hay una regla."
 },
 {
  "i": 24,
  "start": 44.46,
  "end": 45.88,
  "text": "Tu cuerpo dejó de envejecer."
 },
 {
  "i": 25,
  "start": 46.3,
  "end": 47.6,
  "text": "No dejó de ser un cuerpo."
 },
 {
  "i": 26,
  "start": 48.08,
  "end": 48.92,
  "text": "Te puedes romper."
 },
 {
  "i": 27,
  "start": 49.32,
  "end": 50.22,
  "text": "Te puedes enfermar."
 },
 {
  "i": 28,
  "start": 50.78,
  "end": 51.42,
  "text": "Puedes morir."
 },
 {
  "i": 29,
  "start": 51.42,
  "end": 52.26,
  "text": "Solo..."
 },
 {
  "i": 30,
  "start": 52.26,
  "end": 53.84,
  "text": "no te haces viejo."
 },
 {
  "i": 31,
  "start": 54.32,
  "end": 57.4,
  "text": "¿Y qué pasaría si dejaras de envejecer a los veinte?"
 },
 {
  "i": 32,
  "start": 57.4,
  "end": 58.42,
  "text": "Primero, lo bueno."
 },
 {
  "i": 33,
  "start": 58.84,
  "end": 61.44,
  "text": "A tus cuarenta corres como a tus veinte."
 },
 {
  "i": 34,
  "start": 61.44,
  "end": 62.74,
  "text": "Leo jadea en la cancha."
 },
 {
  "i": 35,
  "start": 63.18,
  "end": 64.22,
  "text": "Tú ni sudas."
 },
 {
  "i": 36,
  "start": 64.68,
  "end": 64.98,
  "text": "Bro."
 },
 {
  "i": 37,
  "start": 65.38,
  "end": 65.96,
  "text": "Te odio."
 },
 {
  "i": 38,
  "start": 66.36,
  "end": 67.0,
  "text": "Con cariño."
 },
 {
  "i": 39,
  "start": 67.36,
  "end": 68.12,
  "text": "Pero te odio."
 },
 {
  "i": 40,
  "start": 68.62,
  "end": 69.96,
  "text": "Después, lo raro."
 },
 {
  "i": 41,
  "start": 70.38,
  "end": 72.14,
  "text": "Tu jefe es más joven que tú."
 },
 {
  "i": 42,
  "start": 72.54,
  "end": 73.42,
  "text": "¿Y los clientes?"
 },
 {
  "i": 43,
  "start": 73.74,
  "end": 75.18,
  "text": "Creen que eres el practicante."
 },
 {
  "i": 44,
  "start": 75.68,
  "end": 76.3,
  "text": "Vas al médico."
 },
 {
  "i": 45,
  "start": 76.9,
  "end": 78.42,
  "text": "La doctora mira tus análisis."
 },
 {
  "i": 46,
  "start": 78.94,
  "end": 80.64,
  "text": "Densidad ósea de veinte años."
 },
 {
  "i": 47,
  "start": 80.64,
  "end": 82.14,
  "text": "Presión perfecta."
 },
 {
  "i": 48,
  "start": 82.4,
  "end": 83.32,
  "text": "Arterias limpias."
 },
 {
  "i": 49,
  "start": 83.8,
  "end": 85.92,
  "text": "¿Seguro que esta fecha de nacimiento está bien?"
 },
 {
  "i": 50,
  "start": 85.92,
  "end": 87.66,
  "text": "Bastante seguro, sí."
 },
 {
  "i": 51,
  "start": 88.18,
  "end": 89.84,
  "text": "Tu cuerpo sigue renovándose."
 },
 {
  "i": 52,
  "start": 90.3,
  "end": 93.38,
  "text": "Tus glóbulos rojos se reemplazan cada ciento veinte días."
 },
 {
  "i": 53,
  "start": 93.9,
  "end": 96.5,
  "text": "Tu corazón late unas cien mil veces al día."
 },
 {
  "i": 54,
  "start": 96.92,
  "end": 98.28,
  "text": "Pero algo dentro de ti..."
 },
 {
  "i": 55,
  "start": 98.28,
  "end": 99.48,
  "text": "dejó de contar."
 },
 {
  "i": 56,
  "start": 100.06,
  "end": 102.66,
  "text": "A favor: nunca necesitas lentes para leer."
 },
 {
  "i": 57,
  "start": 103.18,
  "end": 105.28,
  "text": "En contra: el sol te quema igual."
 },
 {
  "i": 58,
  "start": 105.78,
  "end": 106.62,
  "text": "No eres inmortal."
 },
 {
  "i": 59,
  "start": 107.1,
  "end": 107.82,
  "text": "Solo joven."
 },
 {
  "i": 60,
  "start": 108.22,
  "end": 110.44,
  "text": "Pero donde se pone realmente complicado..."
 },
 {
  "i": 61,
  "start": 110.44,
  "end": 111.64,
  "text": "es con la gente."
 },
 {
  "i": 62,
  "start": 112.22,
  "end": 113.4,
  "text": "Dejas de publicar fotos."
 },
 {
  "i": 63,
  "start": 114.08,
  "end": 115.72,
  "text": "Tus vecinos empiezan a preguntar."
 },
 {
  "i": 64,
  "start": 115.72,
  "end": 117.2,
  "text": "¿Tu hijo vive contigo?"
 },
 {
  "i": 65,
  "start": 117.6,
  "end": 117.94,
  "text": "No."
 },
 {
  "i": 66,
  "start": 118.28,
  "end": 118.8,
  "text": "Soy yo."
 },
 {
  "i": 67,
  "start": 119.16,
  "end": 120.86,
  "text": "Te mudas cada diez años."
 },
 {
  "i": 68,
  "start": 121.44,
  "end": 122.58,
  "text": "Y tu perro, Toby..."
 },
 {
  "i": 69,
  "start": 123.1,
  "end": 123.64,
  "text": "envejece."
 },
 {
  "i": 70,
  "start": 124.14,
  "end": 125.48,
  "text": "Su hocico se vuelve gris."
 },
 {
  "i": 71,
  "start": 125.96,
  "end": 128.26,
  "text": "Tú lo cargas en brazos en su último paseo."
 },
 {
  "i": 72,
  "start": 128.66,
  "end": 130.4,
  "text": "Tus brazos tienen veinte años."
 },
 {
  "i": 73,
  "start": 131.0,
  "end": 132.56,
  "text": "Él tiene catorce."
 },
 {
  "i": 74,
  "start": 132.56,
  "end": 133.48,
  "text": "Y hay un costo."
 },
 {
  "i": 75,
  "start": 133.9,
  "end": 134.94,
  "text": "Nadie habla de él."
 },
 {
  "i": 76,
  "start": 135.34,
  "end": 136.66,
  "text": "Cada persona que amas..."
 },
 {
  "i": 77,
  "start": 136.66,
  "end": 138.48,
  "text": "se aleja un poco cada año."
 },
 {
  "i": 78,
  "start": 138.88,
  "end": 139.46,
  "text": "No se va."
 },
 {
  "i": 79,
  "start": 139.98,
  "end": 140.52,
  "text": "Envejece."
 },
 {
  "i": 80,
  "start": 141.04,
  "end": 143.38,
  "text": "Y tú te quedas en la orilla, mirando."
 },
 {
  "i": 81,
  "start": 143.38,
  "end": 144.46,
  "text": "¿Amigos nuevos?"
 },
 {
  "i": 82,
  "start": 145.08,
  "end": 145.58,
  "text": "¿Para qué?"
 },
 {
  "i": 83,
  "start": 146.02,
  "end": 147.22,
  "text": "Igual tendrás que mudarte."
 },
 {
  "i": 84,
  "start": 147.8,
  "end": 151.06,
  "text": "La soledad larga sube el cortisol, la hormona del estrés."
 },
 {
  "i": 85,
  "start": 151.6,
  "end": 152.92,
  "text": "Tu cuerpo no envejece..."
 },
 {
  "i": 86,
  "start": 153.26,
  "end": 154.96,
  "text": "pero tu ánimo sí se cansa."
 },
 {
  "i": 87,
  "start": 155.46,
  "end": 155.96,
  "text": "¿El problema?"
 },
 {
  "i": 88,
  "start": 156.48,
  "end": 157.52,
  "text": "Esconderte funciona."
 },
 {
  "i": 89,
  "start": 157.92,
  "end": 159.52,
  "text": "Hasta que deja de funcionar."
 },
 {
  "i": 90,
  "start": 159.86,
  "end": 162.78,
  "text": "Y solo hay una persona que nunca te obligó a esconderte."
 },
 {
  "i": 91,
  "start": 163.3,
  "end": 163.8,
  "text": "Tu mamá."
 },
 {
  "i": 92,
  "start": 163.8,
  "end": 165.56,
  "text": "Tiene setenta y ocho años."
 },
 {
  "i": 93,
  "start": 166.2,
  "end": 167.06,
  "text": "Camina despacio."
 },
 {
  "i": 94,
  "start": 167.5,
  "end": 169.38,
  "text": "Y en el marco de la puerta de la cocina..."
 },
 {
  "i": 95,
  "start": 169.38,
  "end": 170.46,
  "text": "hay rayitas."
 },
 {
  "i": 96,
  "start": 170.96,
  "end": 172.42,
  "text": "Una por cada cumpleaños."
 },
 {
  "i": 97,
  "start": 172.42,
  "end": 175.34,
  "text": "Las rayitas subieron hasta los veinte."
 },
 {
  "i": 98,
  "start": 175.34,
  "end": 177.6,
  "text": "Después se quedaron en el mismo lugar."
 },
 {
  "i": 99,
  "start": 178.02,
  "end": 179.92,
  "text": "Pero ella nunca dejó de marcarlas."
 },
 {
  "i": 100,
  "start": 180.46,
  "end": 183.32,
  "text": "Cada año dibuja otra línea encima de la anterior."
 },
 {
  "i": 101,
  "start": 183.82,
  "end": 186.1,
  "text": "Y escribe al lado: 'Igual de alto."
 },
 {
  "i": 102,
  "start": 186.68,
  "end": 188.02,
  "text": "Igual de mío.'"
 },
 {
  "i": 103,
  "start": 188.02,
  "end": 189.96,
  "text": "¿Mamá, por qué sigues haciendo eso?"
 },
 {
  "i": 104,
  "start": 190.48,
  "end": 193.24,
  "text": "Porque los años no se miden en centímetros, Sam."
 },
 {
  "i": 105,
  "start": 193.94,
  "end": 195.74,
  "text": "Un martes, todo se rompe."
 },
 {
  "i": 106,
  "start": 196.24,
  "end": 198.12,
  "text": "Alguien encuentra tu foto de 2001."
 },
 {
  "i": 107,
  "start": 198.64,
  "end": 200.02,
  "text": "La pone junto a una de ayer."
 },
 {
  "i": 108,
  "start": 200.48,
  "end": 201.18,
  "text": "Mismo lunar."
 },
 {
  "i": 109,
  "start": 201.18,
  "end": 204.02,
  "text": "La publicación se vuelve viral en una noche."
 },
 {
  "i": 110,
  "start": 204.7,
  "end": 207.9,
  "text": "Al día siguiente, un auto negro se detiene frente a tu casa."
 },
 {
  "i": 111,
  "start": 208.66,
  "end": 209.36,
  "text": "Soy el señor Black."
 },
 {
  "i": 112,
  "start": 209.74,
  "end": 210.8,
  "text": "Trabajo para Eterna."
 },
 {
  "i": 113,
  "start": 211.24,
  "end": 213.4,
  "text": "Tu sangre vale más que cualquier país."
 },
 {
  "i": 114,
  "start": 214.02,
  "end": 216.12,
  "text": "Te ofrece una cifra con nueve ceros."
 },
 {
  "i": 115,
  "start": 216.6,
  "end": 218.46,
  "text": "A cambio, vives en su laboratorio."
 },
 {
  "i": 116,
  "start": 218.92,
  "end": 220.08,
  "text": "Sin fecha de salida."
 },
 {
  "i": 117,
  "start": 220.6,
  "end": 221.56,
  "text": "Y si no firmas..."
 },
 {
  "i": 118,
  "start": 221.98,
  "end": 222.88,
  "text": "¿Si no firmo?"
 },
 {
  "i": 119,
  "start": 223.3,
  "end": 225.84,
  "text": "Le damos tu nombre a cada periodista del mundo."
 },
 {
  "i": 120,
  "start": 226.26,
  "end": 228.44,
  "text": "Tienes hasta mañana a las ocho."
 },
 {
  "i": 121,
  "start": 228.44,
  "end": 230.02,
  "text": "Esa noche cenas con tu mamá."
 },
 {
  "i": 122,
  "start": 230.02,
  "end": 232.32,
  "text": "Ella se ríe de un chiste malo."
 },
 {
  "i": 123,
  "start": 232.34,
  "end": 233.02,
  "text": "Y de pronto..."
 },
 {
  "i": 124,
  "start": 233.52,
  "end": 234.5,
  "text": "se queda quieta."
 },
 {
  "i": 125,
  "start": 234.96,
  "end": 235.8,
  "text": "La cuchara cae."
 },
 {
  "i": 126,
  "start": 236.24,
  "end": 237.72,
  "text": "Su cuerpo se va hacia un lado."
 },
 {
  "i": 127,
  "start": 238.18,
  "end": 238.88,
  "text": "No respira."
 },
 {
  "i": 128,
  "start": 239.34,
  "end": 240.08,
  "text": "Paro cardíaco."
 },
 {
  "i": 129,
  "start": 240.56,
  "end": 241.56,
  "text": "Llamas a emergencias."
 },
 {
  "i": 130,
  "start": 242.06,
  "end": 242.7,
  "text": "¿La ambulancia?"
 },
 {
  "i": 131,
  "start": 242.7,
  "end": 243.74,
  "text": "Ocho minutos."
 },
 {
  "i": 132,
  "start": 244.4,
  "end": 249.36,
  "text": "Por cada minuto sin ayuda, la probabilidad de sobrevivir baja cerca de un diez por ciento."
 },
 {
  "i": 133,
  "start": 249.36,
  "end": 251.74,
  "text": "Pones las manos en el centro de su pecho."
 },
 {
  "i": 134,
  "start": 251.74,
  "end": 253.94,
  "text": "Cinco centímetros de profundidad."
 },
 {
  "i": 135,
  "start": 254.3,
  "end": 257.16,
  "text": "Entre cien y ciento veinte compresiones por minuto."
 },
 {
  "i": 136,
  "start": 257.16,
  "end": 259.92,
  "text": "Una persona normal se cansa en dos minutos."
 },
 {
  "i": 137,
  "start": 260.56,
  "end": 260.76,
  "text": "¿Tú?"
 },
 {
  "i": 138,
  "start": 261.2,
  "end": 263.02,
  "text": "Tus brazos tienen veinte años."
 },
 {
  "i": 139,
  "start": 263.62,
  "end": 264.36,
  "text": "No paras."
 },
 {
  "i": 140,
  "start": 264.8,
  "end": 265.02,
  "text": "Uno."
 },
 {
  "i": 141,
  "start": 265.52,
  "end": 265.88,
  "text": "Dos."
 },
 {
  "i": 142,
  "start": 266.48,
  "end": 266.76,
  "text": "Tres."
 },
 {
  "i": 143,
  "start": 267.38,
  "end": 267.68,
  "text": "Cuatro."
 },
 {
  "i": 144,
  "start": 267.68,
  "end": 269.44,
  "text": "Minuto siete."
 },
 {
  "i": 145,
  "start": 269.44,
  "end": 270.04,
  "text": "La sirena."
 },
 {
  "i": 146,
  "start": 270.48,
  "end": 272.02,
  "text": "Los paramédicos toman el control."
 },
 {
  "i": 147,
  "start": 272.58,
  "end": 273.1,
  "text": "¿Su corazón?"
 },
 {
  "i": 148,
  "start": 273.1,
  "end": 274.04,
  "text": "Vuelve."
 },
 {
  "i": 149,
  "start": 274.52,
  "end": 274.98,
  "text": "Débil..."
 },
 {
  "i": 150,
  "start": 275.52,
  "end": 276.04,
  "text": "pero vuelve."
 },
 {
  "i": 151,
  "start": 276.52,
  "end": 278.28,
  "text": "En el hospital, tu teléfono vibra."
 },
 {
  "i": 152,
  "start": 278.72,
  "end": 279.14,
  "text": "Es Black."
 },
 {
  "i": 153,
  "start": 279.66,
  "end": 280.38,
  "text": "Sé dónde estás."
 },
 {
  "i": 154,
  "start": 280.92,
  "end": 283.16,
  "text": "Tenemos un tratamiento experimental para tu madre."
 },
 {
  "i": 155,
  "start": 283.16,
  "end": 284.56,
  "text": "Solo ven ahora."
 },
 {
  "i": 156,
  "start": 285.14,
  "end": 286.26,
  "text": "Firma y la ayudamos."
 },
 {
  "i": 157,
  "start": 286.26,
  "end": 287.78,
  "text": "Miras el reloj."
 },
 {
  "i": 158,
  "start": 288.22,
  "end": 288.82,
  "text": "Miras la puerta."
 },
 {
  "i": 159,
  "start": 289.4,
  "end": 290.58,
  "text": "Miras su mano en la cama."
 },
 {
  "i": 160,
  "start": 291.12,
  "end": 291.86,
  "text": "El laboratorio..."
 },
 {
  "i": 161,
  "start": 291.86,
  "end": 293.52,
  "text": "o la mano de tu mamá."
 },
 {
  "i": 162,
  "start": 293.8,
  "end": 294.56,
  "text": "No lo dudas."
 },
 {
  "i": 163,
  "start": 295.02,
  "end": 295.7,
  "text": "Te sientas."
 },
 {
  "i": 164,
  "start": 296.14,
  "end": 297.0,
  "text": "Le tomas la mano."
 },
 {
  "i": 165,
  "start": 297.0,
  "end": 298.54,
  "text": "Y apagas el teléfono."
 },
 {
  "i": 166,
  "start": 299.18,
  "end": 301.36,
  "text": "A las ocho, Black cumple su amenaza."
 },
 {
  "i": 167,
  "start": 301.94,
  "end": 302.36,
  "text": "Pero llega..."
 },
 {
  "i": 168,
  "start": 302.36,
  "end": 303.1,
  "text": "tarde."
 },
 {
  "i": 169,
  "start": 303.76,
  "end": 305.84,
  "text": "A las siete, tú ya contaste la verdad."
 },
 {
  "i": 170,
  "start": 306.36,
  "end": 306.86,
  "text": "Tú mismo."
 },
 {
  "i": 171,
  "start": 307.36,
  "end": 307.94,
  "text": "En un video."
 },
 {
  "i": 172,
  "start": 308.38,
  "end": 309.24,
  "text": "Sin esconderte."
 },
 {
  "i": 173,
  "start": 309.76,
  "end": 314.3,
  "text": "Y te ofreciste a hospitales públicos, con científicos de verdad, como la doctora Lee."
 },
 {
  "i": 174,
  "start": 314.72,
  "end": 315.7,
  "text": "Pruebas abiertas."
 },
 {
  "i": 175,
  "start": 315.7,
  "end": 317.24,
  "text": "Resultados para todos."
 },
 {
  "i": 176,
  "start": 317.7,
  "end": 318.72,
  "text": "Nada a la venta."
 },
 {
  "i": 177,
  "start": 319.14,
  "end": 324.44,
  "text": "Un laboratorio serio nunca te pide firmar esa misma noche, sin abogado y bajo amenaza."
 },
 {
  "i": 178,
  "start": 324.98,
  "end": 326.74,
  "text": "Black se queda sin nada que vender."
 },
 {
  "i": 179,
  "start": 327.38,
  "end": 329.22,
  "text": "Leo aparece en el hospital con café."
 },
 {
  "i": 180,
  "start": 329.72,
  "end": 330.1,
  "text": "Amigo."
 },
 {
  "i": 181,
  "start": 330.58,
  "end": 332.04,
  "text": "Siempre supe que eras raro."
 },
 {
  "i": 182,
  "start": 332.54,
  "end": 334.02,
  "text": "Y tu mamá abre los ojos."
 },
 {
  "i": 183,
  "start": 334.64,
  "end": 335.58,
  "text": "Lo primero que pide..."
 },
 {
  "i": 184,
  "start": 335.58,
  "end": 336.72,
  "text": "es un lápiz."
 },
 {
  "i": 185,
  "start": 337.18,
  "end": 338.0,
  "text": "La llevas a casa."
 },
 {
  "i": 186,
  "start": 338.54,
  "end": 340.4,
  "text": "Ella se para frente al marco de la puerta."
 },
 {
  "i": 187,
  "start": 341.02,
  "end": 342.32,
  "text": "Dibuja otra rayita."
 },
 {
  "i": 188,
  "start": 342.74,
  "end": 344.26,
  "text": "En el mismo lugar de siempre."
 },
 {
  "i": 189,
  "start": 344.26,
  "end": 345.68,
  "text": "'Igual de alto."
 },
 {
  "i": 190,
  "start": 346.26,
  "end": 347.54,
  "text": "Igual de mío.'"
 },
 {
  "i": 191,
  "start": 347.54,
  "end": 349.06,
  "text": "Y por primera vez en años..."
 },
 {
  "i": 192,
  "start": 349.48,
  "end": 350.82,
  "text": "no tienes que esconderte."
 },
 {
  "i": 193,
  "start": 350.82,
  "end": 353.5,
  "text": "Tres semanas después, llega una carta."
 },
 {
  "i": 194,
  "start": 354.06,
  "end": 354.78,
  "text": "Letra a mano."
 },
 {
  "i": 195,
  "start": 354.78,
  "end": 356.26,
  "text": "'Lo vi en las noticias."
 },
 {
  "i": 196,
  "start": 356.72,
  "end": 358.76,
  "text": "Yo también me detuve a los veinte."
 },
 {
  "i": 197,
  "start": 358.76,
  "end": 359.44,
  "text": "En 1890."
 },
 {
  "i": 198,
  "start": 360.6,
  "end": 362.24,
  "text": "Tenemos que hablar.'"
 },
 {
  "i": 199,
  "start": 362.24,
  "end": 364.72,
  "text": "¿Y tú qué harías con veinte años para siempre?"
 },
 {
  "i": 200,
  "start": 365.28,
  "end": 368.34,
  "text": "Cuéntanos a qué edad te gustaría detenerte en los comentarios."
 },
 {
  "i": 201,
  "start": 368.94,
  "end": 371.52,
  "text": "Y si la rayita de tu mamá te tocó el corazón..."
 },
 {
  "i": 202,
  "start": 371.52,
  "end": 374.28,
  "text": "dale like y suscríbete para la Parte Dos."
 }
]